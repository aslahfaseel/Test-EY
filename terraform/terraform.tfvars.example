# AWS Configuration
aws_region = "us-east-1"
environment = "dev"

# EKS Cluster Configuration
cluster_name    = "demo-eks-cluster"
cluster_version = "1.28"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# Node Group Configuration
node_desired_size    = 2
node_min_size        = 2
node_max_size        = 5
node_instance_types  = ["t3.medium"]
node_disk_size       = 20

